---
import { site, whatsappUrl } from '../data/site';
---

<section id="contacto" class="bg-mint py-20">
	<div class="mx-auto max-w-6xl px-6">
		<h2 class="font-display text-4xl font-normal text-green sm:text-5xl">Contacto</h2>
		<p class="mt-5 leading-relaxed text-ink/75">
			Para consultas o reservas sobre nuestros paseos y experiencias en el Delta:
		</p>

		<div class="mt-10 grid gap-12 lg:grid-cols-2">
			<div>
				<ul class="space-y-4 text-ink">
					<li class="flex items-center gap-3">
						<svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-ink">
							<path
								d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6Zm2 0 8 6 8-6H4Zm16 2.24-7.4 5.55a1 1 0 0 1-1.2 0L4 8.24V18h16V8.24Z"
							/>
						</svg>
						<a href={`mailto:${site.email}`} class="hover:text-green">{site.email}</a>
					</li>
					<li class="flex items-center gap-3">
						<svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 fill-ink">
							<path
								d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1.1L6.6 10.8Z"
							/>
						</svg>
						<a href={`tel:+${site.whatsappNumber}`} class="hover:text-green">{site.phoneDisplay}</a>
					</li>
				</ul>

				<div class="mt-6 flex flex-wrap gap-3">
					<a
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="h-4 w-4 fill-white">
							<path
								d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
							/>
						</svg>
						WhatsApp
					</a>
					<a
						href={site.instagramUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-2 rounded-full bg-gradient-to-tr from-amber-400 via-pink-500 to-purple-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:opacity-90"
					>
						{site.instagramHandle}
					</a>
				</div>
			</div>

			<form id="contact-form" class="space-y-6">
			<input type="hidden" name="access_key" value={site.web3formsAccessKey} />
			<input type="hidden" name="subject" value="Nueva consulta desde deltaexperiencesarg.com" />
			<input type="checkbox" name="botcheck" class="hidden" style="display: none" />

			<div class="grid gap-6 sm:grid-cols-2">
				<input
					name="first_name"
					type="text"
					required
					placeholder="Nombre*"
					class="w-full border-0 border-b border-ink/20 bg-transparent px-0 py-2 text-sm placeholder:text-ink/50 focus:border-green focus:outline-none focus:ring-0"
				/>
				<input
					name="last_name"
					type="text"
					placeholder="Apellido*"
					class="w-full border-0 border-b border-ink/20 bg-transparent px-0 py-2 text-sm placeholder:text-ink/50 focus:border-green focus:outline-none focus:ring-0"
				/>
			</div>

			<div class="grid gap-6 sm:grid-cols-2">
				<input
					name="phone"
					type="tel"
					placeholder="Teléfono*"
					class="w-full border-0 border-b border-ink/20 bg-transparent px-0 py-2 text-sm placeholder:text-ink/50 focus:border-green focus:outline-none focus:ring-0"
				/>
				<input
					name="email"
					type="email"
					required
					placeholder="Email*"
					class="w-full border-0 border-b border-ink/20 bg-transparent px-0 py-2 text-sm placeholder:text-ink/50 focus:border-green focus:outline-none focus:ring-0"
				/>
			</div>

			<textarea
				name="message"
				rows="3"
				placeholder="¿Que consulta querías compartir?"
				class="w-full border-0 border-b border-ink/20 bg-transparent px-0 py-2 text-sm placeholder:text-ink/50 focus:border-green focus:outline-none focus:ring-0"
			></textarea>

			<button
				type="submit"
				class="rounded-full border border-ink/20 px-8 py-3 text-sm font-medium text-ink transition hover:bg-ink hover:text-white disabled:opacity-60"
			>
				Enviar
			</button>

			<p id="form-status" class="text-sm" role="status"></p>
		</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('form-status');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
		if (submitButton) submitButton.disabled = true;
		if (status) status.textContent = 'Enviando...';

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(Object.fromEntries(new FormData(form))),
			});
			const result = await response.json();

			if (result.success) {
				if (status) {
					status.textContent = '¡Gracias! Tu mensaje fue enviado, te contactaremos a la brevedad.';
					status.className = 'text-sm text-green';
				}
				form.reset();
			} else {
				throw new Error(result.message ?? 'Error desconocido');
			}
		} catch (error) {
			if (status) {
				status.textContent = 'Hubo un problema al enviar el formulario. Escribinos por WhatsApp mientras lo solucionamos.';
				status.className = 'text-sm text-red-600';
			}
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
