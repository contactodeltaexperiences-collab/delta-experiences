---
const experiences = [
	{
		name: 'Familiar',
		image: '/images/ai-scene-1.jpg',
		text: 'Disfrute de un momento único con sus seres queridos navegando por el Delta. Una experiencia diseñada para crear recuerdos inolvidables en un entorno seguro y relajado, ideal para compartir en familia.',
	},
	{
		name: 'Amigos',
		image: '/images/ai-scene-2.jpg',
		text: 'Viva una experiencia vibrante junto a sus amigos, explorando el Delta mientras disfruta de buena música, brindis y risas. El plan perfecto para celebrar o simplemente desconectar juntos.',
	},
	{
		name: 'Romántico',
		image: '/images/ai-scene-4.jpg',
		text: 'Diseñado para parejas que buscan disfrutar de una experiencia privada, rodeados de paisajes únicos, atardeceres inolvidables y detalles que harán cada momento especial.',
	},
];
---

<section id="experiencias" class="mx-auto max-w-6xl px-6 py-20">
	<h2 class="font-display text-center text-4xl font-normal text-green sm:text-5xl">Nuestras experiencias</h2>

	<div class="mt-12 grid gap-8 sm:grid-cols-3">
		{
			experiences.map((exp) => (
				<div class="group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5">
					<div class="aspect-[4/3] overflow-hidden">
						<img
							src={exp.image}
							alt={exp.name}
							class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
							loading="lazy"
						/>
					</div>
					<div class="p-6">
						<h3 class="font-display text-2xl font-normal text-ink">{exp.name}</h3>
						<p class="mt-3 text-sm leading-relaxed text-ink/70">{exp.text}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
