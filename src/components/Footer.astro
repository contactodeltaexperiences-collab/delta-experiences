---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink py-12 text-white/80">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 text-center">
		<img src="/images/logo.png" alt={site.name} class="h-10 w-auto opacity-90" />
		<div class="flex flex-col gap-1 text-sm sm:flex-row sm:gap-6">
			<span>Teléfono: {site.phoneDisplay}</span>
			<span>Email: {site.email}</span>
		</div>
		<p class="text-xs text-white/50">© {year} {site.name}. Todos los derechos reservados.</p>
	</div>
</footer>
