---
import { site } from '../data/site';
---

<footer class="bg-white py-8">
	<div class="flex flex-col items-center justify-between gap-4 py-2 pl-[29px] pr-[74px] text-center sm:flex-row sm:text-left">
		<div class="text-base text-black">
			<p>
				<strong class="font-bold text-[#6c7c69]">Teléfono:</strong>{' '}
				<a href={`tel:+${site.whatsappNumber}`} class="hover:underline">{site.phoneDisplay}</a>
			</p>
			<p>
				<strong class="font-bold text-[#6c7c69]">Email:</strong>{' '}
				<a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a>
			</p>
		</div>
		<img src="/images/logo.png" alt={site.name} class="h-[70px] w-auto" />
	</div>
</footer>
