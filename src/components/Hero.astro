---
import { site } from '../data/site';
---

<section
	id="top"
	class="relative flex h-[100svh] min-h-[560px] items-center justify-center overflow-hidden bg-fixed bg-cover bg-center"
	style="background-image: url('/images/hero-photo.png');"
>
	<div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/35 to-black/60"></div>

	<div class="relative z-10 mx-auto max-w-3xl px-6 text-center text-white">
		<h1 class="font-display text-5xl font-normal leading-tight sm:text-7xl">
			{site.name}
		</h1>
		<p class="mt-4 text-lg text-white/85 sm:text-xl">
			{site.tagline}
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
			<a
				href="#contacto"
				class="rounded-full bg-gold px-7 py-3 text-sm font-semibold text-cream shadow-lg transition hover:bg-gold-dark"
			>
				Contactanos
			</a>
		</div>
	</div>
</section>
