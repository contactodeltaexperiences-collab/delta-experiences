---
import { site } from '../data/site';

const paymentMethods = [
	'Efectivo en dólares',
	'Pix para clientes brasileros',
	'Pesos argentinos (al tipo de cambio actual)',
];
---

<section class="bg-cream py-20">
	<div class="mx-auto grid max-w-6xl gap-8 px-6 lg:grid-cols-[1fr_auto] lg:items-center">
		<div>
			<h2 class="font-display text-3xl font-normal text-green sm:text-4xl">¿Cómo reservar?</h2>
			<p class="mt-5 leading-relaxed text-ink/75">
				Escribinos por WhatsApp, mail, Instagram o teléfono y elegí cuando vivir tu experiencia en
				el Delta.
			</p>
			<p class="mt-4 leading-relaxed text-ink/75">
				Te respondemos al instante y a disfrutar, que nosotros nos encargamos del resto.
			</p>

			<h4 class="font-subtitle mt-10 text-2xl font-normal text-green sm:text-[28px]">Formas de pago</h4>
			<ul class="mt-5 space-y-3">
				{
					paymentMethods.map((method) => (
						<li class="flex items-center gap-3 text-ink/75">
							<span class="text-gold-dark">→</span>
							{method}
						</li>
					))
				}
			</ul>
		</div>
		<div class="aspect-[230/410] w-56 shrink-0 overflow-hidden rounded-2xl bg-ink">
			<video
				id="reservar-video"
				class="h-full w-full object-cover"
				autoplay
				muted
				playsinline
				loop
				data-hls-src={site.heroVideoHls}
			></video>
		</div>
	</div>
</section>

<script>
	import Hls from 'hls.js';

	const video = document.getElementById('reservar-video') as HTMLVideoElement | null;
	const src = video?.dataset.hlsSrc;

	if (video && src) {
		if (video.canPlayType('application/vnd.apple.mpegurl')) {
			video.src = src;
		} else if (Hls.isSupported()) {
			const hls = new Hls();
			hls.loadSource(src);
			hls.attachMedia(video);
		}
	}
</script>
